# Copy to .env for local development. nomic-embed-text emits 768-dimensional vectors.
SPRING_APPLICATION_NAME=rag-document-qa
PORT=8080

POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5433/ragdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update
JPA_OPEN_IN_VIEW=false
HIBERNATE_FORMAT_SQL=false

MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=100MB

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

PGVECTOR_INITIALIZE_SCHEMA=true
EMBEDDING_DIMENSIONS=768
PGVECTOR_DISTANCE_TYPE=COSINE_DISTANCE
PGVECTOR_INDEX_TYPE=HNSW
PGVECTOR_SCHEMA=public
PGVECTOR_TABLE=vector_store
PGVECTOR_REMOVE_EXISTING_TABLE=false

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_HISTORY_MESSAGES=12
RAG_MAX_UPLOAD_BYTES=20971520
RAG_MAX_UPLOADS_PER_REQUEST=5
